# ==============================================================================
# .gitignore — Gisele S. Andrade Imóveis (Next.js + TypeScript + pnpm)
# ==============================================================================

# 1. Dependências e Gerenciadores de Pacote
node_modules/
.pnpm-store/
.npm/
.yarn/

# 2. Builds e Artefatos do Next.js
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 3. Segredos e Variáveis de Ambiente (Regra Absoluta de Segurança)
.env
.env.*
!.env.example

# Chaves, Certificados, Tokens e Credenciais
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
.npmrc
.netrc

# 4. Logs e Arquivos de Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 5. Sistema Operacional e Arquivos Temporários
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 6. IDEs e Editores
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# 7. Testes e Cobertura
coverage/
.nyc_output/
*.lcov

# 8. Caches Locais e Diagnósticos
.turbo/
.cache/
.vercel/
.eslintcache
